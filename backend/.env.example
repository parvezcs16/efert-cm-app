APP_NAME="Central Mess Management System"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://mess:mess@localhost:5432/mess

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

SECRET_KEY=change-me-in-production

# Comma-separated list of company email domains allowed at self-registration.
ALLOWED_EMAIL_DOMAINS=example.com
